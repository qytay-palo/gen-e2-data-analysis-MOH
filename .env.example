# Environment Configuration Template
# Copy this file to .env and fill in your actual values
# DO NOT commit .env file to version control

# ============================================================================
# Project Settings
# ============================================================================
PROJECT_NAME=moh-infectious-disease-analysis
PROJECT_ENV=development  # Options: development, staging, production
LOG_LEVEL=INFO  # Options: DEBUG, INFO, WARNING, ERROR, CRITICAL

# ============================================================================
# Kaggle API Credentials
# ============================================================================
# Get your credentials from: https://www.kaggle.com/account
# Or place kaggle.json in ~/.kaggle/
KAGGLE_USERNAME=your_kaggle_username
KAGGLE_KEY=your_kaggle_api_key

# ============================================================================
# Databricks (HEALIX) Configuration
# ============================================================================
# Workspace URL (e.g., https://adb-1234567890123456.7.azuredatabricks.net/)
DATABRICKS_HOST=https://your-workspace.cloud.databricks.com

# Personal Access Token (generate from User Settings > Access Tokens)
DATABRICKS_TOKEN=your_databricks_token

# Workspace ID (optional, found in workspace URL)
DATABRICKS_WORKSPACE_ID=your_workspace_id

# ============================================================================
# Database Configuration (if using external database)
# ============================================================================
DB_HOST=localhost
DB_PORT=5432
DB_NAME=moh_infectious_disease
DB_USER=your_db_user
DB_PASSWORD=your_db_password

# ============================================================================
# Data Paths (Local Development)
# ============================================================================
DATA_DIR=./data
RAW_DATA_DIR=./data/1_raw
PROCESSED_DATA_DIR=./data/4_processed
MODELS_DIR=./models
RESULTS_DIR=./results
LOGS_DIR=./logs

# ============================================================================
# Model Configuration
# ============================================================================
FORECAST_HORIZON=12  # weeks
CONFIDENCE_LEVEL=0.95
MODEL_VERSION=1.0

# ============================================================================
# Alert Thresholds
# ============================================================================
DENGUE_OUTBREAK_THRESHOLD=300  # weekly cases
HFMD_OUTBREAK_THRESHOLD=500  # weekly cases
FORECAST_ALERT_ENABLED=true

# ============================================================================
# Email Notifications (optional)
# ============================================================================
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@example.com
SMTP_PASSWORD=your_email_password
ALERT_RECIPIENTS=stakeholder1@moh.gov.sg,stakeholder2@moh.gov.sg
