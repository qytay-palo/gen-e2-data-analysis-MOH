# Environment Variables Template
# MOH Healthcare Analytics Project
# 
# INSTRUCTIONS:
# 1. Copy this file to .env
# 2. Fill in your actual credentials
# 3. NEVER commit .env to version control

# ============================================================================
# Kaggle API Credentials
# Get from: https://www.kaggle.com/account
# ============================================================================
KAGGLE_USERNAME=your_kaggle_username
KAGGLE_KEY=your_kaggle_api_key

# ============================================================================
# Databricks Configuration
# ============================================================================
DATABRICKS_HOST=https://your-workspace.cloud.databricks.com
DATABRICKS_TOKEN=your_databricks_access_token
DATABRICKS_CLUSTER_ID=your_cluster_id

# ============================================================================
# Database Connection (if applicable)
# ============================================================================
DB_HOST=localhost
DB_PORT=5432
DB_NAME=moh_analytics
DB_USER=your_db_username
DB_PASSWORD=your_db_password

# ============================================================================
# Project Configuration
# ============================================================================
PROJECT_ROOT=/path/to/gen-e2-data-analysis-MOH
DATA_ROOT=/path/to/data
LOG_LEVEL=INFO

# ============================================================================
# Environment
# ============================================================================
ENVIRONMENT=development  # development, staging, production
TIMEZONE=Asia/Singapore

# ============================================================================
# API Keys (for external data sources if needed)
# ============================================================================
# WEATHER_API_KEY=your_weather_api_key
# GEOSPATIAL_API_KEY=your_geospatial_api_key

# ============================================================================
# Email Notifications (optional)
# ============================================================================
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=your_email@example.com
# SMTP_PASSWORD=your_email_password
# ALERT_EMAIL=alerts@example.com
