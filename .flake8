[flake8]
# MOH Healthcare Analytics - Flake8 Configuration

# Maximum line length
max-line-length = 100

# Exclude directories
exclude =
    .git,
    __pycache__,
    .venv,
    venv,
    env,
    build,
    dist,
    *.egg-info,
    .tox,
    .pytest_cache,
    .mypy_cache,
    data,
    logs,
    models,
    notebooks

# Ignore specific errors
ignore =
    E203,  # Whitespace before ':' (conflicts with black)
    E266,  # Too many leading '#' for block comment
    E501,  # Line too long (handled by black)
    W503,  # Line break before binary operator (conflicts with black)
    W504,  # Line break after binary operator
    E402,  # Module level import not at top of file
    F401,  # Module imported but unused (in __init__.py files)

# Maximum complexity
max-complexity = 10

# Per-file ignores
per-file-ignores =
    __init__.py:F401,F403
    tests/*:F811,F401

# Show source code for errors
show-source = true

# Show statistics
statistics = true

# Count errors
count = true
